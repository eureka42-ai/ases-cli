{
  "name": "ases-engineering-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Eureka42 · ASES Engineering Runtime (AER) — monorepo (PHASE-01, sem binários publicados ainda)",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test",
    "ases:dev": "node scripts/ases-dev.mjs",
    "build": "tsc -b tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
